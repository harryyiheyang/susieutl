\name{utl_theta_effects}
\alias{utl_theta_effects}
\title{Extract theta-coordinate posterior effects}
\usage{
utl_theta_effects(fit)
}
\arguments{
  \item{fit}{A \code{utl_theta_ma_ss_fit} object.}
}
\value{A list containing theta posterior means, full covariances, variances, and slot-level moments.}
\description{Returns theta-native posterior effect summaries.}
